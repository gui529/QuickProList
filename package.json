{
  "name": "quickprolist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "migrate": "node scripts/migrate.mjs",
    "migrate:baseline": "node scripts/migrate.mjs --baseline",
    "migrate:status": "node scripts/migrate.mjs --status",
    "build": "npm run migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed:pros": "npx tsx scripts/seed-curated-pros.ts",
    "backfill:logos": "npx tsx scripts/backfill-curated-logos.ts",
    "fetch:campaign-automation-env": "npx vercel env run -e production -- npx tsx scripts/write-campaign-automation-paste.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "stripe": "^22.1.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
